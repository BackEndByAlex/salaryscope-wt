# Environment variables for the application

# GraphQL and API endpoints
VITE_GRAPHQL_URL=your_graphql_endpoint
VITE_API_URL=your_api_endpoint

# Authentication configuration for GitHub and Google OAuth
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_REDIRECT_URI=your_github_redirect_uri

# Authentication configuration for Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=your_google_redirect_uri
